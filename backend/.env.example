# Copy this file to .env for local development. Never commit the real .env.

# SQLAlchemy connection string. Local dev, matching docker-compose.yml:
DATABASE_URL=postgresql+psycopg2://yojanaai:yojanaai_dev_password@localhost:5432/yojanaai

# development | production
ENVIRONMENT=development

# Comma-separated list of allowed frontend origins. Never use "*" in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:4173

# --- Bootstrap scheme dataset import (see scripts/import_bootstrap_schemes.py) ---
# Path to the third-party bootstrap CSV. Never commit the actual dataset
# file, and never hardcode a machine-specific path into application code —
# this is the only place it's configured.
export BOOTSTRAP_DATASET_PATH="$HOME/Downloads/Schemes.csv"
# Recorded once against this source in the data_source_registry table
# (see app/services/scheme_import.py). PROVENANCE UNVERIFIED — see the
# notes field written by scripts/import_bootstrap_schemes.py. This is
# NOT an official Government of India dataset; attribution/license are
# recorded exactly as provided by the dataset (SmartDuke, CC BY 4.0).
BOOTSTRAP_DATASET_NAME=SmartDuke Indian Government Schemes Dataset
BOOTSTRAP_DATASET_LICENSE=CC BY 4.0
BOOTSTRAP_DATASET_URL=
BOOTSTRAP_DATASET_COLLECTED_AT=

# --- Auth ---
# Secret used to sign login tokens. REQUIRED in production — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=dev-only-insecure-secret-change-me
# Login lifetime in minutes (default 30 days).
ACCESS_TOKEN_EXPIRE_MINUTES=43200
